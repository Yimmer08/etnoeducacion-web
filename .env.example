# ─── Supabase ────────────────────────────────────────────────────────────────
# Proyecto de Supabase PROPIO de la fundación. Si se comparte instancia con
# otro proyecto, se comparten las tablas y el bucket: instancia aparte.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: SOLO server-side, nunca al navegador. En este proyecto se usa
# para exactamente dos cosas — firmar las URLs de descarga del bucket privado y
# crear perfiles de colaborador. Ver lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sitio ───────────────────────────────────────────────────────────────────
# URL pública, para los enlaces canónicos, Open Graph y la cita de cada ficha.
# En Vercel, si no se define, se cae a VERCEL_URL (que en un preview cambia en
# cada deploy). Definirla en Production con el dominio real.
NEXT_PUBLIC_SITE_URL=

# ─── Analítica ───────────────────────────────────────────────────────────────
# Sal para el HMAC de la IP en el contador de vistas y descargas. La IP NUNCA
# se guarda en claro (ver lib/analitica/ip.ts).
#
# Cualquier valor aleatorio largo sirve:  openssl rand -hex 32
#
# Sin esta variable el repositorio funciona igual, solo que sin deduplicar: un
# mismo visitante puede sumar varias veces el mismo documento. Es a propósito —
# preferimos una estadística con ruido antes que guardar una IP en claro por
# tener una variable sin configurar.
#
# ⚠️ Si se rota, los hashes viejos dejan de coincidir con los nuevos. Es lo
# esperable en una rotación de secreto, pero implica que la dedupe de esos 30
# minutos se pierde durante la transición.
ANALITICA_IP_SALT=
